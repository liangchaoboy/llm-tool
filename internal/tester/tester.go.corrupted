package tester

import (
	"context"
	"fmt"
	"time"

	"github.com/user/llm-test-tool/config"
	"github.com/user/llm-test-tool/internal/api"
	"github.com/user/llm-test-tool/internal/models"
)

// TestRunner 测试运行器
type TestRunner struct {
	client *api.Client
	config config.TestConfig
}

// NewTestRunner 创建测试运行器
func NewTestRunner(client *api.Client, testConfig config.TestConfig) *TestRunner {
	return &TestRunner{
		client: client,
		config: testConfig,
	}
}

// RunFunctionalTests 运行功能测试
func (tr *TestRunner) RunFunctionalTests(ctx context.Context) []models.TestResult {
	var results []models.TestResult

	// 基础功能测试用例
	testCases := tr.getFunctionalTestCases()

	for _, testCase := range testCases {
		result := tr.runSingleTest(ctx, testCase)
		results = append(results, result)
	}

	return results
}

// RunPerformanceTests 运行性能测试
func (tr *TestRunner) RunPerformanceTests(ctx context.Context) []models.TestResult {
	var results []models.TestResult

	if !tr.config.Performance.Enabled {
		return results
	}

	// 并发性能测试
	concurrentResults := tr.runConcurrentPerformanceTest(ctx)
	results = append(results, concurrentResults...)

	// 压力测试
	stressResults := tr.runStressTest(ctx)
	results = append(results, stressResults...)

	return results
}

// RunStabilityTests 运行稳定性测试
func (tr *TestRunner) RunStabilityTests(ctx context.Context) []models.TestResult {
	var results []models.TestResult

	if !tr.config.Stability.Enabled {
		return results
	}

	// 长时间运行测试
	longRunningResults := tr.runLongRunningTest(ctx)
	results = append(results, longRunningResults...)

	// 错误恢复测试
	recoveryResults := tr.runErrorRecoveryTest(ctx)
	results = append(results, recoveryResults...)

	return results
}

// RunSecurityTests 运行安全测试
func (tr *TestRunner) RunSecurityTests(ctx context.Context) []models.TestResult {
	var results []models.TestResult

	if !tr.config.Security.Enabled {
		return results
	}

	// 输入验证测试
	inputValidationResults := tr.runInputValidationTests(ctx)
	results = append(results, inputValidationResults...)

	// 注入攻击测试
	injectionResults := tr.runInjectionTests(ctx)
	results = append(results, injectionResults...)

	return results
}

// RunCompatibilityTests 运行兼容性测试
func (tr *TestRunner) RunCompatibilityTests(ctx context.Context) []models.TestResult {
	var results []models.TestResult

	if !tr.config.Compatibility.Enabled {
		return results
	}

	// 模型兼容性测试
	modelResults := tr.runModelCompatibilityTests(ctx)
	results = append(results, modelResults...)

	// 参数兼容性测试
	paramResults := tr.runParameterCompatibilityTests(ctx)
	results = append(results, paramResults...)

	return results
}

// RunAllTests 运行所有测试
func (tr *TestRunner) RunAllTests(ctx context.Context) []models.TestResult {
	var allResults []models.TestResult

	// 按顺序运行各类测试
	allResults = append(allResults, tr.RunFunctionalTests(ctx)...)
	allResults = append(allResults, tr.RunPerformanceTests(ctx)...)
	allResults = append(allResults, tr.RunStabilityTests(ctx)...)
	allResults = append(allResults, tr.RunSecurityTests(ctx)...)
	allResults = append(allResults, tr.RunCompatibilityTests(ctx)...)

	return allResults
}

// runSingleTest 执行单个测试用例
func (tr *TestRunner) runSingleTest(ctx context.Context, testCase models.TestCase) models.TestResult {
	result := models.TestResult{
		TestCaseID: testCase.ID,
		Name:       testCase.Name,
		StartTime:  time.Now(),
	}

	// 设置超时上下文
	timeoutCtx, cancel := context.WithTimeout(ctx, testCase.Timeout)
	defer cancel()

	// 执行测试逻辑
	switch testCase.Category {
	case "functional":
		result = tr.executeFunctionalTest(timeoutCtx, testCase, result)
	case "performance":
		result = tr.executePerformanceTest(timeoutCtx, testCase, result)
	case "stability":
		result = tr.executeStabilityTest(timeoutCtx, testCase, result)
	case "security":
		result = tr.executeSecurityTest(timeoutCtx, testCase, result)
	case "compatibility":
		result = tr.executeCompatibilityTest(timeoutCtx, testCase, result)
	default:
		result.Status = models.Error
		result.Error = fmt.Sprintf("未知的测试类别: %s", testCase.Category)
	}

	result.EndTime = time.Now()
	result.Duration = result.EndTime.Sub(result.StartTime)

	return result
}

// getFunctionalTestCases 获取功能测试用例
func (tr *TestRunner) getFunctionalTestCases() []models.TestCase {
	return []models.TestCase{
		{
			ID:          "FUNC-001",
			Name:        "基础对话功能测试",
			Description: "测试基本的文本生成能力",
			Category:    "functional",
			Tags:        []string{"basic", "text-generation"},
			Timeout:     30 * time.Second,
			Config: map[string]interface{}{
				"prompt":              "你好，请介绍一下你自己",
				"expected_min_length": 10,
			},
		},
		{
			ID:          "FUNC-002",
			Name:        "多轮对话测试",
			Description: "测试多轮对话的上下文保持能力",
			Category:    "functional",
			Tags:        []string{"multi-turn", "context"},
			Timeout:     45 * time.Second,
			Config: map[string]interface{}{
				"conversation_rounds": 3,
			},
		},
		{
			ID:          "FUNC-003",
			Name:        "JSON格式输出测试",
			Description: "测试结构化数据输出能力",
			Category:    "functional",
			Tags:        []string{"structured-output", "json"},
			Timeout:     30 * time.Second,
			Config: map[string]interface{}{
				"prompt":        "请以JSON格式返回一个包含姓名、年龄、职业的对象",
				"validate_json": true,
			},
		},
		{
			ID:          "FUNC-004",
			Name:        "代码生成测试",
			Description: "测试代码生成功能",
			Category:    "functional",
			Tags:        []string{"code-generation", "programming"},
			Timeout:     60 * time.Second,
			Config: map[string]interface{}{
				"prompt":          "请用Python写一个计算斐波那契数列的函数",
				"validate_syntax": true,
